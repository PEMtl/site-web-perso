# ══════════════════════════════════════════════════════════════════
# IMPORTANT DÉPLOIEMENT : ce fichier commence par un point (dotfile).
# La plupart des clients FTP (FileZilla, etc.) le MASQUENT par défaut.
# Active "Afficher les fichiers cachés" avant de l'uploader, sinon
# aucune des règles ci-dessous (sécurité, cache, 404) ne s'applique.
# ══════════════════════════════════════════════════════════════════

# ── HTTPS strict (HSTS 1 an) ──
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
</IfModule>

# ── Compression Gzip ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json application/xml
</IfModule>

# ── Cache navigateur : Cache-Control explicite (pas seulement Expires) ──
# PageSpeed Insights exige un en-tête Cache-Control avec max-age, Expires seul ne suffit pas.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                  "access plus 1 hour"
  ExpiresByType text/css                   "access plus 1 year"
  ExpiresByType application/javascript     "access plus 1 year"
  ExpiresByType application/manifest+json  "access plus 1 week"
  ExpiresByType image/webp                 "access plus 1 year"
  ExpiresByType image/png                  "access plus 1 year"
  ExpiresByType image/svg+xml              "access plus 1 year"
  ExpiresByType image/x-icon               "access plus 1 year"
  ExpiresByType font/woff2                 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Assets statiques versionnés implicitement par nom de fichier stable :
  # "immutable" indique au navigateur de ne jamais revalider avant expiration.
  # ⚠️ Si tu remplaces une image/police en gardant le même nom de fichier,
  # les visiteurs récents la verront avec un an de retard — renomme le fichier
  # (ex. photo-profil-v2.webp) et mets à jour les références si tu la changes.
  <FilesMatch "\.(css|js|woff2|webp|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "manifest\.json$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# ── Security headers ──
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
  # CSP durcie : zéro unsafe-inline (honeypot en classe CSS, swap CSS via script.js externe)
  Header always set Content-Security-Policy "default-src 'self'; connect-src 'self' https://formspree.io; style-src 'self'; font-src 'self'; img-src 'self' data:; script-src 'self'; base-uri 'self'; form-action 'self' https://formspree.io; frame-ancestors 'none';"
</IfModule>

# ── Redirection www → non-www (canonique = non-www partout) ──
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# ── Page 404 personnalisée ──
# Toute URL sans fichier/dossier correspondant renvoie ce contenu avec le
# statut HTTP 404 (bon pour le SEO — pas de redirection, l'URL demandée
# reste affichée). Fonctionne pour N'IMPORTE QUELLE URL inexistante,
# à la racine ou dans un sous-chemin (ex. /machin, /a/b/c).
#
# ⚠️ EXIGENCE OVH/APACHE : le chemin "/404.html" est résolu depuis LA RACINE
# du site. Le fichier 404.html doit donc être déposé au même niveau que ce
# .htaccess et index.html — jamais dans un sous-dossier. Si le 404 ne
# s'affiche toujours pas après déploiement, vérifie en premier lieu que :
#   1. Ce .htaccess est bien uploadé (voir avertissement dotfile en tête
#      du fichier, et dans le README section "AVANT DE DÉPLOYER")
#   2. 404.html est bien à la racine exacte du site
#   3. Test : curl -I https://pe-monreal.com/url-qui-nexiste-pas
#      doit renvoyer "HTTP/1.1 404 Not Found"
ErrorDocument 404 /404.html
